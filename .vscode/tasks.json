{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Shifter: Backend (npm run dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "node",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Shifter API listening"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Shifter: DB setup",
      "type": "shell",
      "command": "npm run db:setup",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "reveal": "always" }
    }
  ]
}
